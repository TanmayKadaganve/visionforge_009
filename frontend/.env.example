# Google Maps JavaScript API key for Google basemaps in Leaflet.
# Enable Maps JavaScript API, enable billing, and restrict this key to your app origins.
VITE_GOOGLE_MAPS_API_KEY=
# OAuth 2.0 Web client ID; add your app origin as an authorized JavaScript origin.
VITE_GOOGLE_CLIENT_ID=
# Optional direct API origin override. Leave blank to use Vite's local proxy and Vercel's same-origin API rewrite.
VITE_API_BASE_URL=
