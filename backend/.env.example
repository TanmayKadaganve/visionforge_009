# Use the same OAuth 2.0 Web application client ID as VITE_GOOGLE_CLIENT_ID.
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=rideflow
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
CLIENT_URL=http://localhost:5173
NODE_ENV=development
# Use lax with Vercel's same-origin /api reverse proxy; use none only for direct cross-site API calls.
COOKIE_SAME_SITE=
GOOGLE_CLIENT_ID=

# Optional admin bootstrap (run npm run seed:admin after configuring backend/.env).
ADMIN_NAME=RideFlow Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=+919876543210
ADMIN_PASSWORD=replace_with_a_strong_password_of_12_chars_minimum

# Optional per-category fare overrides (INR)
# FARE_BIKE_BASE_INR=15
# FARE_BIKE_PER_KM_INR=8
# FARE_SCOOTER_BASE_INR=18
# FARE_SCOOTER_PER_KM_INR=9
# FARE_AUTO_BASE_INR=25
# FARE_AUTO_PER_KM_INR=11
# FARE_MINI_BASE_INR=30
# FARE_MINI_PER_KM_INR=12
# FARE_SEDAN_BASE_INR=45
# FARE_SEDAN_PER_KM_INR=15
# FARE_SUV_BASE_INR=65
# FARE_SUV_PER_KM_INR=21
# FARE_PREMIUM_BASE_INR=100
# FARE_PREMIUM_PER_KM_INR=30
# FARE_ELECTRIC_BASE_INR=35
# FARE_ELECTRIC_PER_KM_INR=13
